# Minoza Store Environment Configuration
# Copy to .env for local dev. In production, set these as environment
# variables in the Vercel project dashboard instead (Project > Settings >
# Environment Variables) — never commit real secrets to git.
PORT=3000

# Supabase (Project Settings > API)
# SUPABASE_SERVICE_KEY is the "service_role" secret key — server-only,
# never expose it to the browser. Without these two set, the app falls
# back to local JSON files under server/data/ (fine for local dev, but
# NOT usable on Vercel, whose filesystem is read-only at runtime).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Stripe Credentials (dashboard.stripe.com > Developers > API keys)
# Leave blank to use Cash-on-Delivery / simulated PromptPay QR only.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Meta Ads & Conversions API (CAPI) — Meta Events Manager > Settings
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=

# LINE Notify (notify-bot.line.me) — order alert token
LINE_NOTIFY_TOKEN=
